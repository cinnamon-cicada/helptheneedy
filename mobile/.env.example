# Copy to .env.local. Run `npx supabase status` from the repo root for local values.
# Physical devices can't reach 127.0.0.1, so use your computer's LAN IP on them.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Only the publishable key belongs here. Never put a secret or service role key in the app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
